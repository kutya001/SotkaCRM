# ==============================================================================
# Supabase Configuration
# ==============================================================================
# URL вашего проекта в Supabase (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Публичный анонимный ключ для выполнения клиентских запросов с учетом RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Сервисный секретный ключ (Service Role Key)
# ИСПОЛЬЗОВАТЬ ТОЛЬКО НА СЕРВЕРЕ (Route Handlers, Server Actions). Дает доступ в обход RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# Sotka API Integration Settings
# ==============================================================================
# Базовый URL внешнего сервиса
SOTKA_API_BASE_URL=https://api.sotka.kg

# Код страны юрисдикции (+996)
SOTKA_API_ISO_CODE_ID=1

# Номер телефона учетной записи администратора (без кода страны, 9 цифр)
SOTKA_API_PHONE=700888268

# Пароль учетной записи администратора
SOTKA_API_PASSWORD=your_secure_password_here

# ==============================================================================
# Application Environment & Scheduled Tasks
# ==============================================================================
# Базовый домен приложения для CORS и редиректов авторизации
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Секретный токен для фоновых задач синхронизации (Vercel Cron: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your_cron_secret_token_here